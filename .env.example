DATABASE_URL="postgresql://todouser:todopass@localhost:5432/tododb"

# Secret used to sign session JWTs. Set a strong, random value in production.
# REQUIRED in production: when NODE_ENV=production and JWT_SECRET is unset the
# app throws rather than silently signing tokens with the known dev default.
# Outside production an insecure dev default is used so build/tests stay green.
JWT_SECRET="dev-insecure-secret-change-me-in-production"

# Reminders & notifications.
# Shared secret an external scheduler/cron presents in the X-Dispatch-Secret
# header to trigger POST /api/reminders/dispatch without a user session. Leave
# unset to keep that endpoint behind the normal user auth guard only.
REMINDER_DISPATCH_SECRET=""

# Email notification transport (config-gated). Both must be set for the email
# transport to attempt delivery; otherwise it logs and no-ops.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# Push notification transport (config-gated). Set to enable the push transport;
# otherwise it logs and no-ops.
PUSH_PROVIDER_API_KEY=""

# API hardening (FEAT-010).
# Rate limiting. Disabled by default (safe for tests/dev). Set to "true" to
# enable. Keyed by authenticated user id (else client IP). NOTE: the limiter is
# an in-process fixed-window counter - correct on a SINGLE instance only. A
# multi-instance or serverless deployment MUST back it with a shared store
# (Redis/Upstash) implementing the RateLimitStore interface in lib/rate-limit.ts.
RATE_LIMIT_ENABLED="false"
# Max requests allowed per window per key (default 100).
RATE_LIMIT_MAX="100"
# Rate-limit window length in milliseconds (default 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS="60000"

# Structured request logging (method, path, status, duration, user id) to the
# console as one JSON line per request. Enabled by default; set to "false" to
# silence (the test suite sets this). Never logs bodies, headers, or secrets.
REQUEST_LOG_ENABLED="true"
