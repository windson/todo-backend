generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  todos      Todo[]
  categories Category[]
  tags       Tag[]
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    Priority  @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Recurrence: when recurrenceRule is set, completing this todo generates the
  // next occurrence with dates advanced by `recurrenceInterval` units of the
  // rule's frequency. recurrenceGeneratedId records the id of the occurrence
  // that was spawned so completing the same todo twice does not create
  // duplicates (the second completion is a no-op for generation).
  recurrenceRule        RecurrenceRule?
  recurrenceInterval    Int             @default(1)
  recurrenceGeneratedId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  parentId String?
  parent   Todo?   @relation("TodoSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Todo[]  @relation("TodoSubtasks")

  tags TodoTag[]

  @@index([userId])
  @@index([categoryId])
  @@index([parentId])
  @@index([priority])
  @@index([completed])
  @@index([dueDate])
  @@index([startDate])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos Todo[]

  @@unique([userId, name])
  @@index([userId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  todos TodoTag[]

  @@unique([userId, name])
  @@index([userId])
}

model TodoTag {
  todoId String
  tagId  String

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([todoId, tagId])
  @@index([todoId])
  @@index([tagId])
}
